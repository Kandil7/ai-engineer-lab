# ---- Secrets / env ----
.env
.env.local
*.local.env
**/secrets/*
!**/secrets/.gitkeep

# ---- Go ----
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
bin/
vendor/

# ---- Python / FastAPI ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# ---- Node / Next.js ----
node_modules/
.next/
out/
dist/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Flutter / Dart ----
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
.packages
*.iml

# ---- Docker / data volumes ----
infra/docker/**/data/
*.pid

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE (keep .idea project meta tracked already, ignore local noise) ----
.vscode/
*.swp
*~

# ---- Logs / coverage ----
*.log
coverage/
*.cover

# ---- Generated artifacts (regenerable — do not commit) ----
# Plot output from matplotlib/scipy exercises. ~10MB, reproduced by re-running the scripts.
# Note: PNGs committed under outputs/ predate this rule and stay tracked until
# untracked deliberately: git rm -r --cached outputs/
**/output/*.png
**/output/
outputs/**/*.png
.coverage
projects/00-core-foundations/python/*.png
*.sqlite
*.sqlite3
projects/00-core-foundations/python/*.db
err.txt
graphify-out/