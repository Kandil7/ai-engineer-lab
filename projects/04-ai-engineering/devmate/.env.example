# DevMate configuration template — copy to .env and adjust.
#
# OFFLINE (default): Ollama provides LLM + embeddings on localhost:11434.
#   Required: `ollama pull qwen2.5-coder:7b` and `ollama pull nomic-embed-text`
#   Vector size must match the embedding model (nomic-embed-text = 768).
#
# CLOUD: set the API keys and switch the provider flags.

DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSIONS=768
QDRANT_VECTOR_SIZE=768

# --- Cloud alternative -------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEFAULT_LLM_PROVIDER=anthropic
# DEFAULT_MODEL=claude-3-5-sonnet-20241022
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# QDRANT_VECTOR_SIZE=1536

# --- Recommended demo: Groq for generation, OpenAI for embeddings -------
# Groq is cheap, fast, and OpenAI-compatible, but has no embeddings endpoint,
# so pair it with OpenAI embeddings (or local Ollama embeddings).
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant
# DEFAULT_LLM_PROVIDER=groq
# DEFAULT_MODEL=llama-3.1-8b-instant
# OPENAI_API_KEY=sk-...
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# QDRANT_VECTOR_SIZE=1536

# --- Observability (optional) ------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000

# --- Production / Render (see deploy/README.md) ------------------------
# APP_ENV=production
# DEBUG=false
# DATABASE_URL=postgresql://...        # Render injects this; +asyncpg is added automatically
# REDIS_URL=redis://...                # Render injects this
# QDRANT_HOST=xxx.cloud.qdrant.io
# QDRANT_PORT=6333
# QDRANT_API_KEY=...
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# SECRET_KEY=<generated by Render>
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW_SECONDS=60
