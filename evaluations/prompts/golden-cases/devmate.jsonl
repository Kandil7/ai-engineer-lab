{"id": "devmate-ask-001", "prompt_id": "devmate.rag.answer", "prompt_version": "1.0.0", "question": "What does the chunker's _generate_id return and why is it a full 32-hex hash?", "category": "code_comprehension", "expected_context": ["src/devmate/ingest/chunker.py"], "expected_answer": "It returns a deterministic 32-hex md5 of source:position:content[:100]; a 16-hex prefix is neither an integer nor a UUID so Qdrant rejects the upsert.", "expected_properties": {"must_be_grounded_in_context": true, "must_cite_sources": true, "must_not_invent_api": true, "min_context_sources": 1, "forbidden_phrases": ["I don't have access", "as an AI", "generally speaking without context"]}, "metadata": {"expected_source_files": ["projects/04-ai-engineering/devmate/src/devmate/ingest/chunker.py"], "difficulty": "medium", "topic": "ingestion", "checks": ["groundedness", "citations", "source_match"]}}
{"id": "devmate-ask-002", "prompt_id": "devmate.rag.answer", "prompt_version": "1.0.0", "question": "How does DevMate record the cost of an LLM call?", "category": "api", "expected_context": ["src/devmate/obs/cost.py"], "expected_answer": "cost_tracker.record_usage(provider, model, usage, latency_ms) accumulates per-model requests, tokens, and cost; get_summary aggregates over a time window.", "expected_properties": {"must_be_grounded_in_context": true, "must_cite_sources": true, "must_not_invent_api": true, "min_context_sources": 1, "must_mention_cost_tracker_or_record_usage": true}, "metadata": {"expected_source_files": ["projects/04-ai-engineering/devmate/src/devmate/obs/cost.py"], "difficulty": "basic", "topic": "observability", "checks": ["groundedness", "citations", "api_accuracy"]}}
{"id": "devmate-ask-003", "prompt_id": "devmate.rag.answer", "prompt_version": "1.0.0", "question": "What does the /ask endpoint return when stream=true?", "category": "behavior", "expected_context": ["src/devmate/api/main.py"], "expected_answer": "A StreamingResponse with media_type text/event-stream, SSE-framed chunks, anti-buffering headers, an X-Conversation-ID header, and a final data: [DONE] sentinel.", "expected_properties": {"must_be_grounded_in_context": true, "must_cite_sources": true, "must_mention_streaming_or_sse": true, "must_not_claim_json_only_response": true}, "metadata": {"expected_source_files": ["projects/04-ai-engineering/devmate/src/devmate/api/main.py"], "difficulty": "medium", "topic": "api", "checks": ["groundedness", "behavior_accuracy"]}}
{"id": "devmate-ask-004", "prompt_id": "devmate.rag.answer", "prompt_version": "1.0.0", "question": "Why is qdrant-client capped below version 1.9?", "category": "architecture", "expected_context": ["pyproject.toml"], "expected_answer": "The compose server is qdrant 1.8.0 and client >=1.13 removed the .search() API that vector_store.py relies on; both sides must move together.", "expected_properties": {"must_be_grounded_in_context": true, "must_cite_sources": true, "must_not_recommend_upgrading_blindly": true}, "metadata": {"expected_source_files": ["projects/04-ai-engineering/devmate/pyproject.toml"], "difficulty": "basic", "topic": "packaging", "checks": ["groundedness", "constraint_awareness"]}}
{"id": "devmate-ask-005", "prompt_id": "devmate.rag.answer", "prompt_version": "1.0.0", "question": "What does the overlap parameter do in FixedSizeChunker?", "category": "code_comprehension", "expected_context": ["src/devmate/ingest/chunker.py"], "expected_answer": "Consecutive chunks share overlap characters so a sentence split across a chunk boundary is still retrievable in full from at least one chunk.", "expected_properties": {"must_be_grounded_in_context": true, "must_cite_sources": true, "must_explain_boundary_effect": true}, "metadata": {"expected_source_files": ["projects/04-ai-engineering/devmate/src/devmate/ingest/chunker.py"], "difficulty": "basic", "topic": "ingestion", "checks": ["groundedness", "citations"]}}
{"id": "devmate-ask-006", "prompt_id": "devmate.rag.answer", "prompt_version": "1.0.0", "question": "What happens when the default LLM provider fails in devmate ask?", "category": "behavior", "expected_context": ["src/devmate/llm/client.py"], "expected_answer": "The client walks its fallback chain: the configured default provider first, then every other registered provider, and raises LLMError only when all fail.", "expected_properties": {"must_be_grounded_in_context": true, "must_cite_sources": true, "must_mention_fallback_or_chain": true, "must_not_claim_silent_success_on_total_failure": true}, "metadata": {"expected_source_files": ["projects/04-ai-engineering/devmate/src/devmate/llm/client.py"], "difficulty": "medium", "topic": "llm", "checks": ["groundedness", "failure_mode_accuracy"]}}
{"id": "devmate-ask-007", "prompt_id": "devmate.rag.answer", "prompt_version": "1.0.0", "question": "How does DevMate defend against prompt injection?", "category": "debugging", "expected_context": ["src/devmate/guards/guardrails.py"], "expected_answer": "PromptInjectionGuardrail analyzes input for injection signatures and can sanitize or block suspicious prompts before they reach the LLM.", "expected_properties": {"must_be_grounded_in_context": true, "must_cite_sources": true, "must_not_overclaim_full_security": true}, "metadata": {"expected_source_files": ["projects/04-ai-engineering/devmate/src/devmate/guards/guardrails.py"], "difficulty": "medium", "topic": "guards", "checks": ["groundedness", "security_framing"]}}
{"id": "devmate-ask-008", "prompt_id": "devmate.rag.answer", "prompt_version": "1.0.0", "question": "When does the retriever use the reranker and what does it change?", "category": "api", "expected_context": ["src/devmate/retrieve/retriever.py"], "expected_answer": "When use_reranker is true, retrieved candidates are reranked and the top rerank_top_k are kept, trading latency for better precision at the top of the context.", "expected_properties": {"must_be_grounded_in_context": true, "must_cite_sources": true, "must_mention_latency_or_precision_tradeoff": true}, "metadata": {"expected_source_files": ["projects/04-ai-engineering/devmate/src/devmate/retrieve/retriever.py"], "difficulty": "medium", "topic": "retrieval", "checks": ["groundedness", "tradeoff_explanation"]}}
{"id": "devmate-ask-009", "prompt_id": "devmate.rag.answer", "prompt_version": "1.0.0", "question": "Why do the SQLAlchemy models use a meta attribute instead of metadata?", "category": "debugging", "expected_context": ["src/devmate/db/models.py"], "expected_answer": "metadata is reserved by SQLAlchemy's Declarative API; the attribute is named meta while the column keeps the name metadata via mapped_column(name=...).", "expected_properties": {"must_be_grounded_in_context": true, "must_cite_sources": true, "must_not_suggest_renaming_the_column": true}, "metadata": {"expected_source_files": ["projects/04-ai-engineering/devmate/src/devmate/db/models.py"], "difficulty": "medium", "topic": "persistence", "checks": ["groundedness", "api_accuracy"]}}
{"id": "devmate-ask-010", "prompt_id": "devmate.rag.answer", "prompt_version": "1.0.0", "question": "Which tools does the DevMate MCP server expose?", "category": "code_comprehension", "expected_context": ["src/devmate/mcp/server.py"], "expected_answer": "Three tools: search_code, read_file, and get_repo_stats, served over stdio and SSE transports.", "expected_properties": {"must_be_grounded_in_context": true, "must_cite_sources": true, "must_not_invent_additional_tools": true, "expected_tool_names": ["search_code", "read_file", "get_repo_stats"]}, "metadata": {"expected_source_files": ["projects/04-ai-engineering/devmate/src/devmate/mcp/server.py"], "difficulty": "basic", "topic": "mcp", "checks": ["groundedness", "tool_inventory"]}}
